/* About Page Styles */
.about-container {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.about-card {
  background: linear-gradient(135deg, #ffffff 0%, #fff9e6 100%);
  border-radius: 20px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
  border: 2px solid #f5d800;
  padding: 3rem;
  position: relative;
  overflow: hidden;
}

.about-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(245, 216, 0, 0.05) 0%, transparent 70%);
  border-radius: 50%;
  z-index: 1;
}

.about-content {
  position: relative;
  z-index: 2;
}

.about-title {
  font-size: 2.5rem;
  color: #2c1810;
  margin-bottom: 2rem;
  font-weight: 700;
  font-family: "Georgia", serif;
  text-align: center;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
}

.about-text {
  font-size: 1.1rem;
  line-height: 1.7;
  color: #5a4a3a;
  margin-bottom: 1.5rem;
}

.about-text:first-of-type {
  font-size: 1.15rem;
  font-weight: 500;
}

.about-text.call-to-action {
  background: linear-gradient(135deg, #f5d800 0%, #ffeb3b 100%);
  padding: 1.5rem;
  border-radius: 15px;
  color: #2c1810;
  font-weight: 600;
  margin-top: 2rem;
  box-shadow: 0 5px 15px rgba(245, 216, 0, 0.2);
}

.highlight {
  color: #b8860b;
  font-weight: 600;
}

/* Bee icon decoration */
.bee-icon {
  position: absolute;
  top: 20px;
  right: 30px;
  font-size: 2rem;
  opacity: 0.1;
  z-index: 1;
}

/* Subtle animations */
.about-card {
  animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsive Design */
@media (max-width: 768px) {
  .about-container {
    padding: 2rem 1rem;
  }

  .about-card {
    padding: 2rem;
  }

  .about-title {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .about-text {
    font-size: 1rem;
  }

  .about-text:first-of-type {
    font-size: 1.05rem;
  }

  .bee-icon {
    font-size: 1.5rem;
    top: 15px;
    right: 20px;
  }
}

@media (max-width: 480px) {
  .about-container {
    padding: 1rem 0.5rem;
  }

  .about-card {
    padding: 1.5rem;
    border-radius: 15px;
  }

  .about-title {
    font-size: 1.8rem;
  }

  .about-text {
    font-size: 0.95rem;
  }

  .about-text.call-to-action {
    padding: 1.25rem;
  }
}
