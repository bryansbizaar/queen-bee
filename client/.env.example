# =============================================================================
# Client Environment Variables Template
# =============================================================================
# 
# IMPORTANT: This is a template file. Copy this to .env and fill in your values.
# Never commit the actual .env file to version control!
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values
#   3. Restart the Vite dev server to pick up changes
#
# Note: Vite requires environment variables to be prefixed with VITE_
# =============================================================================

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------

# Stripe Publishable Key (pk_test_... for testing, pk_live_... for production)
# Get this from: https://dashboard.stripe.com/apikeys
# This is safe to expose in client-side code
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Important:
# - Use test keys (pk_test_) during development
# - This key is public and will be visible in browser
# - Match the environment with your server (test with test, live with live)

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Backend API base URL
# Development: http://localhost:8080
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8080

# Note: No trailing slash on the API URL

# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# Enable debug mode for additional console logging
# VITE_DEBUG_MODE=false

# Google Analytics ID (if using analytics)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Feature flags (for gradual rollouts)
# VITE_FEATURE_CUSTOMER_ACCOUNTS=false
# VITE_FEATURE_PRODUCT_REVIEWS=false

# -----------------------------------------------------------------------------
# Environment-Specific Examples
# -----------------------------------------------------------------------------

# Development:
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_API_URL=http://localhost:8080

# Staging:
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_API_URL=https://staging-api.yourdomain.com

# Production:
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# VITE_API_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# Security Notes
# -----------------------------------------------------------------------------
# 
# ✅ DO:
#   - Keep .env in .gitignore
#   - Use VITE_ prefix for all variables (Vite requirement)
#   - Use different API URLs for different environments
#   - Use test Stripe keys during development
#
# ❌ DON'T:
#   - Commit .env to version control
#   - Put secret keys in client env (they'll be exposed in browser)
#   - Forget to restart dev server after changing env vars
#   - Mix test and live Stripe keys
#
# Note: Client-side env vars are PUBLIC and embedded in the build.
# Only put non-sensitive configuration here.
# =============================================================================
