# CI/CD Environment Variables for GitHub Actions
# This file is used ONLY in the GitHub Actions CI/CD pipeline

NODE_ENV=test
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=queen_bee_test
DATABASE_USER=bryanowens
DATABASE_PASSWORD=testpassword
DATABASE_URL=postgres://bryanowens:testpassword@localhost:5432/queen_bee_test

# Default to using Stripe mocks unless real keys are provided
USE_STRIPE_MOCKS=true
STRIPE_SECRET_KEY=sk_test_mock_key_for_testing
STRIPE_PUBLISHABLE_KEY=pk_test_mock_key_for_testing

# Test-specific settings
DISABLE_RATE_LIMITING=true
DISABLE_CORS=true
LOG_LEVEL=silent
